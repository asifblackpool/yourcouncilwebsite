@model string?

@if (!string.IsNullOrWhiteSpace(Model))
{
    @Html.Raw(Model)
}
else
{
    <h2 style="margin-top: 0px;">Meeting webcasts</h2>
    <p>
        Our meetings are webcast so that you can see how the council makes
        decisions that affect you. Our aim is to promote openness and
        accountability, and to support greater participation in local democracy.
    </p>
}

<h2 id="current-title">&nbsp;</h2>
<div id="webcasts-video" class="editor">
    <h2>Webcast</h2>
    <div id="iframe-loading-indicator" style="position: relative; left: 40%; top: 50%; display: none;">
        <strong>
            <img alt="" src="/SiteElements/ChannelShift/content/images/gif.gif" /> ... Loading
        </strong>
    </div>
    <div class="iframe-wrapper" style="text-align: center; margin: auto;">
    </div>
    <div id="webcast-video-placeholder"></div>
    <div id="webcasts-links-placeholder"></div>
</div>
<input id="current-hidden-videoId" type="hidden" value="0" />
<input id="current-hidden-title" type="hidden" value="" />
<br />
<div id="contact-details" class="row clearfix">
    <div id="contact-wrapper" class="clearfix">
        <div class="col-md-12 zero-pad-all">
            <h4>Webcasting</h4>
        </div>
        <div id="contact-address" class="col-md-12 zero-pad-all">
            Municipal buildings, Corporation Street, Blackpool, FY1 1NF
        </div>
        <div id="contact-tel" class="col-md-12 zero-pad-all">
            <strong>Telephone&nbsp;</strong>01253 477034
        </div>
        <div id="contact-email" class="col-md-12 zero-pad-all">
            <strong>Email </strong><a href="mailto:democracy@blackpool.gov.uk">Democracy@blackpool.gov.uk</a>
        </div>
    </div>
</div>

<script id="webcast-video-timestamp-template" type="text/x-handlebars-template">
    {{#if apitimestampdata.length}}
        <p>To view individual agenda items click on the links below. </p>
        <h2>Agenda</h2>
        <p>
            {{#each apitimestampdata}}
            <span>
            {{#if this.link.length }}
                <a class="you-tube-link" href="{{ this.link }}">{{ this.title}}</a>
            {{else }}
                {{ this.title}}
            {{/if}}
            <br /></span>
            {{/each}}
        </p>
    {{/if}}
        {{#if democracy.link.length }}
            <p>For full agenda, attendance details and supporting documents visit:<br /><span><a target="_blank" href="{{ democracy.link }}">{{ democracy.text}}</a> </span></p>
        {{/if}}
        {{#unless apidefault.isLatest }}
        <h2>Latest webcast</h2>
        <ul>
            <li><a id="webcast_{{ apidefault.Id }}" class="other-webcast-link" href="#">{{ apidefault.Title}}</a> </li>
       </ul>
       {{/unless}}
</script>

<script id="webcast-video-links-template" type="text/x-handlebars-template">
    {{#if apidata.length }}
    <h2>Other webcasts</h2>
    <p>See webcasts for: </p>
    <ul>
        {{#each apidata}}
        <li><a id="webcast_{{ Id }}"  class="other-webcast-link" href="#">{{ Title}}</a> </li>
        {{/each}}
    </ul>
    {{/if}}
</script>

<script type="text/javascript" src="/SiteElements/ChannelShift/scripts/services/webcastvideoservices.js"></script>
<script type="text/javascript" src="/SiteElements/ChannelShift/scripts/run/runwebcast.js"></script>
